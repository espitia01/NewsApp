# Optional — add at least one for best results (Vercel → Settings → Environment Variables)

# GNews (recommended): https://gnews.io — free 100 req/day, sign up for API key
GNEWS_API_KEY=

# Guardian (free): https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Without keys, the app falls back to BBC/NPR/Reuters RSS feeds on Vercel.
